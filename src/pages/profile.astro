---
import Layout from "../components/Layout.astro";
import { config } from "../config";

const { author, social } = config;
---

<script>
  const buttons = document.querySelectorAll("button.shortcut-btn");

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      scrollToSection((button.textContent as string).trim());
    });
  });
  function scrollToSection(sectionId: string) {
    const header = document.querySelector("header.site-header");
    const headerHeight = header ? (header as HTMLElement).offsetHeight : 0;
    const el = document.getElementById(sectionId);
    if (el) {
      const y =
        el.getBoundingClientRect().top + window.scrollY - headerHeight - 20;
      window.scrollTo({ top: y, behavior: "smooth" });
    }
  }
</script>
<Layout
  title="Profile"
  showSidebar={false}
  description="Profile of Alex Marcus."
