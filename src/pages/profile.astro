        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .profile-page {
    max-width: 800px;
    margin: 0 auto;
  }

  .author-section {
    text-align: left;
    margin-bottom: calc(var(--grid-unit) * 4);
    padding: calc(var(--grid-unit) * 4);
    background-color: var(--color-surface);
    border-radius: calc(var(--grid-unit));
    border: 2px solid var(--color-border);
    display: flex;
    flex-direction: row-reverse;
    flex-wrap: wrap;
    align-items: center;
    gap: calc(var(--grid-unit) * 4);
  }

  .author-info {
    flex: 1;
  }

  .author-avatar {
    flex-shrink: 0;
    margin: 0;
  }

  .author-avatar img {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--color-accent);
    margin: 0;
  }

  .author-name {
    font-family: var(--font-heading-secondary);
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: calc(var(--grid-unit) * 2);
  }

  .author-bio {
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--color-text-primary]);
  }

  .shortcuts {
    display: flex;
    width: 100%;
    gap: calc(var(--grid-unit) * 3);
    justify-content: flex-start;
    align-items: flex-start;
    font-family: var(--font-heading-secondary);
  }

  .shortcuts .arrow {
    font-size: 1.5rem;
    color: var(--color-text-muted);
  }

  .shortcuts .shortcut-btn {
    background: none;
    border: none;
    color: var(--color-accent);
    font-family: inherit;
    font-size: 1.5rem;
    cursor: pointer;
    transition:
      color 0.2s ease,
      transform 0.2s ease;
    padding: 0;
    margin-right: calc(var(--grid-unit) * 2);
  }

  .shortcuts .shortcut-btn::after {
    content: "▼";
    display: inline-block;
    margin-left: calc(var(--grid-unit) * 1);
    font-size: 0.8em;
  }

  .shortcuts .shortcut-btn:hover {
    color: var(--color-text-secondary);
    transform: translateY(-2px);
  }

  .social-icon {
    width: 28px;
    height: 28px;
  }

  .content-section {
    line-height: 1.7;
    border: 2px solid var(--color-border);
    padding: calc(var(--grid-unit) * 4);
    border-radius: calc(var(--grid-unit));
    background-color: var(--color-surface);
    margin-bottom: calc(var(--grid-unit) * 4);
  }

  .content-section h2 {
    color: var(--color-accent);
  }

  .content-section span.subhead {
    display: block;
    font-size: 0.9rem;
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    margin-top: calc(var(--grid-unit) * 0.5);
    text-transform: none;
  }

  .content-section p {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-text-primary);
    margin-bottom: calc(var(--grid-unit) * 3);
  }

  .content-section ul {
    padding-left: calc(var(--grid-unit) * 3);
  }

  .content-section li {
    margin-bottom: calc(var(--grid-unit));
    font-size: 1.125rem;
    line-height: 1.6;
    list-style-type: circle;
  }

  .content-section ul.skills-list {
    margin-top: calc(var(--grid-unit) * 2);
  }

  .content-section ul.skills-list li {
    width: 50%;
    padding-right: 2rem;
    float: left;
  }

  .content-section ul.skills-list li:last-of-type {
    float: none;
  }

  .content-section strong {
    color: var(--color-text-primary);
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: 2.5rem;
    }

    .author-section {
      padding: calc(var(--grid-unit) * 4) calc(var(--grid-unit) * 3);
    }

    .author-name {
      font-size: 2rem;
    }

    .author-bio {
      font-size: 1.125rem;
    }

    .author-section {
      flex-direction: column;
      align-items: center;
    }

    .author-avatar img {
      width: 120px;
      height: 120px;
    }

    .shortcuts {
      flex-direction: column;
      align-items: flex-start;
      gap: calc(var(--grid-unit) * 2);
    }

    .content-section h2 {
      font-size: 1.5rem;
    }

    .content-section p,
    .content-section li {
      font-size: 1rem;
    }

    .content-section ul.skills-list li {
      width: 100%;
    }
  }
</style>
